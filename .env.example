# 複製這個檔案並命名為 .env，填入你自己的金鑰
# cp .env.example .env

# Google AI Studio API 金鑰
# 取得方式：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LINE Messaging API Channel Access Token（長效型）
# 取得方式：LINE Developers Console > 你的 Channel > Messaging API > Channel access token
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 你的 LINE 個人 User ID（以大寫 U 開頭，共 33 碼）
# 取得方式：在 LINE 官方帳號的 Webhook 事件 source.userId 欄位中查看
LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
